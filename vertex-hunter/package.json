{
  "name": "vertex-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "MEXC Futures early-momentum scanner with persistent signal tracking and a virtual $100 paper wallet. Paper trading only.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
